# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/saas_platform

# JWT
JWT_SECRET=change-this-super-secret-value
JWT_EXPIRES_IN=1d

# AWS S3
AWS_REGION=eu-central-1
AWS_S3_BUCKET=saas-platform-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SMTP (nodemailer). If left empty, emails are only logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SaaS Platform <no-reply@saas-platform.local>"
